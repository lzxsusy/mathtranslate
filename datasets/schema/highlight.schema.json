{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://atomgit.com/lzxSUSUY/mathtranslate/datasets/schema/highlight.schema.json",
  "title": "highlight annotation",
  "type": "object",
  "required": ["id", "pkg", "rights", "location", "kind", "what", "why_hard", "strategy", "how_it_unlocks", "evidence", "status", "reviewed_by"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z]{2}\\d{2}-\\d{2}\\.h\\d{3}$"},
    "pkg": {"type": "string", "pattern": "^SY\\d{2}-\\d{2}$"},
    "rights": {"type": "string"},
    "location": {
      "type": "object",
      "required": ["file", "line"],
      "properties": {"file": {"type": "string"}, "line": {"type": "integer"}, "pages": {"type": "array", "items": {"type": "integer"}}}
    },
    "kind": {"enum": ["brilliant_argument", "hard_proof", "key_insight", "subtle_definition", "structural_pivot"]},
    "what": {"type": "string", "maxLength": 500},
    "why_hard": {"type": "string", "maxLength": 600},
    "strategy": {"type": "string", "maxLength": 600},
    "how_it_unlocks": {"type": "string", "maxLength": 500},
    "related_trace": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "object", "required": ["kind", "ref"], "properties": {"kind": {"enum": ["file", "arxiv", "book", "external"]}, "ref": {"type": "string"}, "quote": {"type": "string", "maxLength": 300}}}},
    "status": {"enum": ["draft", "reviewed", "published"]},
    "reviewed_by": {"type": "array", "items": {"type": "string"}, "minItems": 2}
  }
}
