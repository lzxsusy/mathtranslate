{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://atomgit.com/lzxSUSUY/mathtranslate/datasets/schema/trace.schema.json",
  "title": "event-level work trace",
  "type": "object",
  "required": ["trace_id", "seq", "ts", "action", "observation", "outcome"],
  "additionalProperties": false,
  "properties": {
    "trace_id": {"type": "string", "pattern": "^[A-Z]{2}\\d{2}-\\d{2}\\.[a-z0-9-]+$"},
    "seq": {"type": "integer", "minimum": 0},
    "ts": {"type": "string", "description": "ISO-8601 or epoch-ms, as exported"},
    "actor": {"type": "string"},
    "action": {"enum": ["read", "tool", "write", "check", "fix", "decide", "think", "report"]},
    "tool": {"type": "string"},
    "args_digest": {"type": "string", "maxLength": 500},
    "result_digest": {"type": "string", "maxLength": 800},
    "observation": {"type": "string", "maxLength": 800},
    "decision": {"type": "string", "maxLength": 500},
    "error": {"type": "string", "maxLength": 500},
    "outcome": {"enum": ["ok", "error", "partial", "skipped"]},
    "fidelity": {"enum": ["event", "reconstructed"]},
    "source": {"type": "string"}
  }
}
