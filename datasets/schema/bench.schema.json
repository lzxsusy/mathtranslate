{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://atomgit.com/lzxSUSUY/mathtranslate/datasets/schema/bench.schema.json",
  "title": "held-out benchmark item",
  "type": "object",
  "required": ["id", "pkg", "rights", "question", "kind", "rubric", "must_include", "difficulty", "evidence", "status", "reviewed_by"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z]{2}\\d{2}-\\d{2}\\.b\\d{3}$"},
    "pkg": {"type": "string", "pattern": "^SY\\d{2}-\\d{2}$"},
    "rights": {"type": "string"},
    "question": {"type": "string", "maxLength": 800},
    "kind": {"enum": ["translate", "explain", "prove", "find_error", "terminology", "structure"]},
    "reference_answer": {"type": "string", "maxLength": 2000},
    "rubric": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["criterion", "weight"], "properties": {"criterion": {"type": "string"}, "weight": {"type": "number", "minimum": 0, "maximum": 1}}}},
    "must_include": {"type": "array", "items": {"type": "string"}},
    "must_not_include": {"type": "array", "items": {"type": "string"}},
    "difficulty": {"type": "integer", "minimum": 1, "maximum": 5},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["kind", "ref"], "properties": {"kind": {"enum": ["file", "arxiv", "book", "external"]}, "ref": {"type": "string"}, "quote": {"type": "string", "maxLength": 300}}}},
    "status": {"enum": ["draft", "reviewed", "published"]},
    "reviewed_by": {"type": "array", "items": {"type": "string"}, "minItems": 2}
  }
}
