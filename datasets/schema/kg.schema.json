{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://atomgit.com/lzxSUSUY/mathtranslate/datasets/schema/kg.schema.json",
  "title": "knowledge graph node or edge",
  "type": "object",
  "required": ["id", "pkg", "rights", "type", "evidence"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z]{2}\\d{2}-\\d{2}\\.[a-z]\\d{3,4}$"},
    "pkg": {"type": "string", "pattern": "^SY\\d{2}-\\d{2}$"},
    "rights": {"type": "string"},
    "type": {"enum": ["node", "edge"]},
    "node_type": {"enum": ["concept", "theorem", "proof", "person", "paper", "construction", "example"]},
    "label": {"type": "string", "maxLength": 160},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "definition": {"type": "string", "maxLength": 500},
    "edge_type": {"enum": ["prereq_of", "uses", "generalizes", "specializes", "dual_to", "cites", "proved_by", "example_of", "equivalent_to"]},
    "source": {"type": "string"},
    "target": {"type": "string"},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["kind", "ref"], "properties": {"kind": {"enum": ["file", "arxiv", "book", "external"]}, "ref": {"type": "string"}, "quote": {"type": "string", "maxLength": 300}}}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "status": {"enum": ["draft", "reviewed", "published"]}
  }
}
