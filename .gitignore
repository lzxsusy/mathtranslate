# 原文全文抽取（OCR/文本层）同样属 L4，不入库
08_source_code/**/工程文件/work/en_*.txt
08_source_code/**/工程文件/work/*_raw.txt
# 全文抽取（题目名不合 *_raw.txt 约定的）同样属 L4，不入库
08_source_code/**/工程文件/work/fulltext.txt

# 成品 PDF 与编译产物：只留源码，成品走 Release 外链或按 §4 申请
08_source_code/**/成品/*.pdf
