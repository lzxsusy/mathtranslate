{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuyi.local/schemas/claim.schema.json",
  "title": "Claim v2（原子断言 / 知识节点原料）",
  "type": "object",
  "required": ["id", "paper_id", "claim", "type", "anchors", "provenance", "review"],
  "properties": {
    "id": {"type": "string", "pattern": "^c-[a-z0-9-]+$"},
    "paper_id": {"type": "string"},
    "session": {"type": "string"},
    "claim": {"type": "string", "minLength": 8},
    "type": {
      "type": "string",
      "enum": ["evidence", "interpretation", "definition", "open", "conjecture", "method", "result"]
    },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 2},
      "description": "无锚点的断言只能进 questions，不能成为 claim"
    },
    "provenance": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": {
          "type": "string",
          "enum": ["paper", "reading_note", "translation", "reconstruction", "external", "claim"]
        },
        "doc": {"type": "string"},
        "locator": {"type": "string"}
      }
    },
    "legacy_source": {"type": "string", "description": "v1 的 source 字段，原样保留"},
    "premises": {
      "type": "array",
      "items": {"type": "string"},
      "description": "这条断言的推理前提（claim id 或 unit id）"
    },
    "mode": {
      "type": ["string", "null"],
      "enum": ["AND", "OR", "single", null],
      "description": "多个前提如何共同支撑结论；单前提用 single"
    },
    "warrant": {
      "type": ["string", "null"],
      "description": "从前提到结论的授权（为什么这一步成立），不能只写 because"
    },
    "role": {
      "type": ["string", "null"],
      "enum": ["key", "support", "context", null],
      "description": "key = 关键/不可平推步"
    },
    "difficulty": {
      "type": ["object", "null"],
      "properties": {
        "score": {"type": "integer", "minimum": 1, "maximum": 5},
        "reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "concept_hints": {
      "type": "array",
      "items": {"type": "string"},
      "description": "可映射到的概念名（尚未分配 kn_ id 时用）"
    },
    "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
    "status": {"type": "string", "enum": ["active", "accepted", "contested", "provisional", "retired"]},
    "counterpoints": {"type": "array", "items": {"type": "string"}},
    "review": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"type": "string", "enum": ["proposed", "accepted", "rejected", "needs_review", "unresolved"]},
        "reviewers": {"type": "array", "items": {"type": "string"}},
        "note": {"type": "string"}
      }
    }
  }
}
