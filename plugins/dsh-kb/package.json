{
  "name": "dsh-kb",
  "version": "0.3.2",
  "description": "数译知识库 —— 带页码、带来源、带可信度的数学文献资料卡检索（kb_search / kb_card / kb_brief / kb_stats）。自带三层数据：2,782 张资料卡（46 部作品）、4.8 万段中文译文、7,644 段底本原文抽文；纯 JS 检索，零外部依赖。",
  "type": "module",
  "main": "lib/index.js",
  "icon": "assets/icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "MARKET-SUBMIT.md",
    "data",
    "assets",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "knowledge-base",
    "kb",
    "math",
    "translation",
    "cards",
    "langlands",
    "vertex-algebra",
    "corpus",
    "full-text",
    "original-text"
  ],
