{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sem-gl2/crosswalk.schema.json",
  "title": "SEM-GL2 crosswalk record",
  "type": "object",
  "required": [
    "id",
    "type",
    "seminar",
    "lecture",
    "topic",
    "created_by",
    "reviewers",
    "status",
    "license",
    "schema_version",
    "concept",
    "in_lectures",
    "divergence",
    "verdict"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(GL2-(L\\d{2}|U0[1-8])-(RSN|CHL|CPT|CRW|MIS|QCD|MET)-\\d{3,4})$"
    },
    "type": {
      "type": "string"
    },
    "seminar": {
      "type": "string",
      "const": "SEM-GL2"
    },
    "lecture": {
      "type": "string",
      "pattern": "^(L(0[1-9]|1[0-2])|U0[1-8])$",
      "description": "报告单元：U01–U08（v2 轮值报告制）；L01–L12 仅兼容旧数据"
    },
    "topic": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "reviewers": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "reviewed",
        "published"
      ]
    },
    "license": {
      "type": "string",
      "const": "CC-BY-4.0"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "concept": {
      "type": "string"
    },
    "in_lectures": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "text",
          "locator",
          "term_used",
          "definition_gist",
          "role"
        ],
        "properties": {
          "text": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ]
          },
          "locator": {
            "type": "string"
          },
          "term_used": {
            "type": "string"
          },
          "definition_gist": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    "divergence": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "same",
        "refinement",
        "genuine_difference"
      ]
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "description": "轮次，必须与 unit/lecture 的序号一致"
    }
  },
  "x-type": "crosswalk",
  "x-code": "CRW",
  "x-max-lengths": {
    "divergence": 200,
    "definition_gist": 150
  }
}
