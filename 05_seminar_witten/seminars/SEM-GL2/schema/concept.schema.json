{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sem-gl2/concept.schema.json",
  "title": "SEM-GL2 concept record",
  "type": "object",
  "required": [
    "id",
    "type",
    "seminar",
    "lecture",
    "topic",
    "created_by",
    "reviewers",
    "status",
    "license",
    "schema_version",
    "from",
    "to",
    "edge_type",
    "statement",
    "evidence",
    "strength"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(GL2-(L\\d{2}|U0[1-8])-(RSN|CHL|CPT|CRW|MIS|QCD|MET)-\\d{3,4})$"
    },
    "type": {
      "type": "string"
    },
    "seminar": {
      "type": "string",
      "const": "SEM-GL2"
    },
    "lecture": {
      "type": "string",
      "pattern": "^(L(0[1-9]|1[0-2])|U0[1-8])$",
      "description": "报告单元：U01–U08（v2 轮值报告制）；L01–L12 仅兼容旧数据"
    },
    "topic": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "reviewers": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "reviewed",
        "published"
      ]
    },
    "license": {
      "type": "string",
      "const": "CC-BY-4.0"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "from": {
      "type": "string"
    },
    "to": {
      "type": "string"
    },
    "edge_type": {
      "type": "string",
      "enum": [
        "depends_on",
        "dual_to",
        "specializes_to",
        "generalizes",
        "equivalent_to",
        "acts_on",
        "categorifies",
        "deforms_to",
        "obstruction_to"
      ]
    },
    "statement": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "locator"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "text",
              "external",
              "derivation"
            ]
          },
          "locator": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "strength": {
      "type": "string",
      "enum": [
        "strong",
        "medium",
        "weak"
      ]
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "description": "轮次，必须与 unit/lecture 的序号一致"
    }
  },
  "x-type": "concept",
  "x-code": "CPT",
  "x-max-lengths": {
    "statement": 100
  }
}
