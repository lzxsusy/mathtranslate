{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sem-gl2/misconception.schema.json",
  "title": "SEM-GL2 misconception record",
  "type": "object",
  "required": [
    "id",
    "type",
    "seminar",
    "lecture",
    "topic",
    "created_by",
    "reviewers",
    "status",
    "license",
    "schema_version",
    "wrong_statement",
    "why_wrong",
    "correct_version",
    "trigger",
    "diagnostic_question"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(GL2-(L\\d{2}|U0[1-8])-(RSN|CHL|CPT|CRW|MIS|QCD|MET)-\\d{3,4})$"
    },
    "type": {
      "type": "string"
    },
    "seminar": {
      "type": "string",
      "const": "SEM-GL2"
    },
    "lecture": {
      "type": "string",
      "pattern": "^(L(0[1-9]|1[0-2])|U0[1-8])$",
      "description": "报告单元：U01–U08（v2 轮值报告制）；L01–L12 仅兼容旧数据"
    },
    "topic": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "reviewers": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "reviewed",
        "published"
      ]
    },
    "license": {
      "type": "string",
      "const": "CC-BY-4.0"
    },
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "wrong_statement": {
      "type": "string"
    },
    "why_wrong": {
      "type": "string"
    },
    "correct_version": {
      "type": "string"
    },
    "trigger": {
      "type": "string"
    },
    "diagnostic_question": {
      "type": "string"
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "description": "轮次，必须与 unit/lecture 的序号一致"
    }
  },
  "x-type": "misconception",
  "x-code": "MIS",
  "x-max-lengths": {
    "wrong_statement": 120,
    "why_wrong": 200,
    "correct_version": 300,
    "trigger": 150,
    "diagnostic_question": 200
  }
}
