\input{figure-dimensions.tex}
% Drafts can be compiled before later chapters exist. Final validation rejects every pending target.
\newcommand{\BookRef}[2]{\ifcsname r@#1\endcsname\hyperref[#1]{#2}\else#2\PackageWarning{book-adapt}{Pending source reference: #1}\fi}
\newcommand{\BookEqRef}[2]{\BookRef{#1}{(#2)}}
\newcommand{\BookSectionRef}[2]{\BookRef{#1}{第#2节}}
\newcommand{\BookChapterRef}[1]{\BookRef{chap:#1}{第#1章}}
\newcommand{\BookIndexPage}[1]{\hyperref[src:#1]{\pageref*{src:#1}}}
