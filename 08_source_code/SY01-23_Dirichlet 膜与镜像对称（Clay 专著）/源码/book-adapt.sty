\DeclareFieldFormat{note}{#1}
\setlength{\bibitemsep}{0.35\baselineskip}
\setlength{\emergencystretch}{2em}
\widowpenalty=10000
\clubpenalty=10000
\displaywidowpenalty=10000
\AtBeginBibliography{\raggedright}
\newcommand{\BookCite}[1]{\cite{#1}}
\newcommand{\BookBibText}[2]{\hyperlink{cite.0@#1}{#2}}
\newcommand{\SourceParagraph}[2]{\par\phantomsection\label{src:#1}\ignorespaces}
\newcommand{\SourceAnchor}[1]{\phantomsection\label{src:#1}}
\newcommand{\BookStatementNumber}[1]{\setcounter{ELEGANT@samecnt}{\numexpr#1-1\relax}}
\renewenvironment{example}[1][]{\refstepcounter{ELEGANT@samecnt}\par\noindent\textbf{\color{main}\examplename\space\theexam\space#1}\rmfamily}{\par\ignorespacesafterend}
\newenvironment{example*}[1][]{\par\noindent{\normalfont\bfseries\color{main}\examplename\space#1}\quad\rmfamily\ignorespaces}{\par\ignorespacesafterend}
\newenvironment{exercise*}[1][]{\par\noindent\makebox[-3pt][r]{\scriptsize\color{red!90}\HandPencilLeft\quad}{\normalfont\bfseries\color{main}\exercisename\space#1}\quad\rmfamily\ignorespaces}{\par\ignorespacesafterend}
\elegantnewtheorem{axiom}{公理}{thmstyle}{axiom}
\newenvironment{letteraxiom}[1]{\begingroup\renewcommand{\axiomname}{公理\space#1}\begin{axiom*}\phantomsection\def\@currentlabel{#1}}{\end{axiom*}\endgroup}
\renewenvironment{exercise}[1][]{\refstepcounter{ELEGANT@samecnt}\par\noindent\makebox[-3pt][r]{\scriptsize\color{red!90}\HandPencilLeft\quad}\textbf{\color{main}\exercisename\space\theexer\space#1}\rmfamily}{\par\ignorespacesafterend}
\renewenvironment{problem}[1][]{\refstepcounter{ELEGANT@samecnt}\par\noindent\textbf{\color{main}\problemname\space\theprob\space#1}\rmfamily}{\par\ignorespacesafterend}
\renewcommand{\theexam}{\csname theELEGANT@samecnt\endcsname}
\renewcommand{\theexer}{\csname theELEGANT@samecnt\endcsname}
\renewcommand{\theprob}{\csname theELEGANT@samecnt\endcsname}
\let\BookNativeNote\note
\let\BookNativeEndNote\endnote
\renewenvironment{note}[1][]{\begingroup\ifblank{#1}{}{\refstepcounter{ELEGANT@samecnt}\edef\notename{笔记\space\csname theELEGANT@samecnt\endcsname}}\BookNativeNote}{\BookNativeEndNote\endgroup}
\elegantnewtheorem{conjecture}{猜想}{thmstyle}{conj}
\elegantnewtheorem{claim}{断言}{thmstyle}{claim}
\elegantnewtheorem{principle}{原理}{thmstyle}{principle}
\elegantnewtheorem{property}{性质}{thmstyle}{pty}
\elegantnewtheorem{construction}{构造}{thmstyle}{constr}
\newenvironment{lettertheorem}[1]{\begingroup\renewcommand{\theoremname}{定理\space#1}\begin{theorem*}\phantomsection\def\@currentlabel{#1}}{\end{theorem*}\endgroup}
\newenvironment{problem*}[1][]{\par\noindent\textbf{\color{main}\problemname\space#1}\rmfamily}{\par\ignorespacesafterend}
\newcommand{\BookUnsectionedSubsection}[2]{\subsection*{#1\quad#2}\pdfbookmark[1]{#1\space#2}{bookmark:#1}\def\@currentlabel{#1}}
\newcommand{\BookQED}{\hfill\ensuremath{\square}}
\newcommand{\BookNumberOnlyCaption}{\captionsetup{labelsep=none}\caption{}}
